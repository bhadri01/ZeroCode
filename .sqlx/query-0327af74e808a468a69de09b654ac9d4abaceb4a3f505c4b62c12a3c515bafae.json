  "db_name": "PostgreSQL",
  "query": "WITH next AS (SELECT token FROM submissions WHERE status = 'queued' ORDER BY created_at FOR UPDATE SKIP LOCKED LIMIT 1 ) UPDATE submissions s SET status = 'processing', claimed_at = NOW(), worker_id = $1 FROM next WHERE s.token = next.token RETURNING s.token, s.language_id, s.source_code, s.stdin, s.cpu_time_limit, s.wall_time_limit, s.memory_limit_mb, s.max_pids, s.enable_network, s.callback_url",
