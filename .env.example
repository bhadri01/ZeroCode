# ZeroCode environment template — minimal working set.
#
# Copy to `.env` and adjust. Almost every other var has a sensible default
# baked into the code; the full list of optional knobs (api bind, rate limits,
# worker parallelism, sandbox paths, retention) lives in docs/DEPLOY.md §2.
#
# NOTE: ZeroCode's API is unauthenticated — there is no API-key env var.

# Postgres connection string. Used by api, worker, and the migrate binary.
# The only var with no default — the code can't guess your database URL.
DATABASE_URL=postgres://zerocode:zerocode@localhost:5432/zerocode

# tracing/env_filter directive (api, worker, migrate).
RUST_LOG=info,zerocode=debug

# sqlx offline mode: `query!` macros read cached metadata from .sqlx/ instead
# of needing a live DB at compile time. Refresh with `cargo sqlx prepare --workspace`.
SQLX_OFFLINE=true
