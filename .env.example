# ZeroCode environment template.
#
# Copy to `.env` and adjust. ZeroCode does NOT auto-load .env files — this
# template is here so you can:
#   - source it explicitly (`set -a; . ./.env; set +a`)
#   - paste values into your shell, systemd unit, or container orchestrator
#   - see at a glance every var the API + worker read
#
# Required vars have no default and the service will refuse to start without
# them. Optional vars are shown commented out next to their default.
#
# Full reference: docs/DEPLOY.md §2 (Environment variables).


# ─── Required ──────────────────────────────────────────────────────────

# Postgres connection string. Used by API, worker, and the migrate binary.
DATABASE_URL=postgres://zerocode:zerocode@localhost:5432/zerocode

# Static Bearer token for v1 API auth. Rotate by changing this value.
# Production: generate a long random string, never commit it.
ZEROCODE_API_KEY=dev-only-replace-me

# HMAC-SHA256 secret for outbound webhook signatures (X-ZeroCode-Signature
# header). Required if any submission uses a callback_url; leave empty to
# disable webhook signing entirely.
ZEROCODE_WEBHOOK_SECRET=dev-only-replace-me


# ─── API server (zerocode-api) ─────────────────────────────────────────

# Listen address.
ZEROCODE_API_BIND=0.0.0.0:8080

# Per-IP rate limit (tower_governor). 100 RPS / 100 burst is fine for dev;
# tune these for prod traffic shape.
# ZEROCODE_GOVERNOR_RPS=100
# ZEROCODE_GOVERNOR_BURST=100

# Language registry. The default works in dev (`cargo run`) because it's
# relative to the repo root; in containers it's set by the Dockerfile.
# ZEROCODE_LANGUAGES_FILE=runners/languages.toml

# Static fallback served at `/` and `/docs/`. Empty string disables the
# mount entirely (handy for API-only deployments).
# ZEROCODE_WEB_DIR=web/dist


# ─── Browser-facing controls (CORS + anonymous access) ─────────────────

# Comma-separated CORS allowlist. Empty = same-origin only (browser must
# load page from the same host as the API).
# Production: list every origin that embeds the playground:
#   ZEROCODE_CORS_ORIGINS=https://zerocode.example.com
ZEROCODE_CORS_ORIGINS=

# Admit unauthenticated requests under a per-IP quota. Required for the
# public playground; leave false for private deployments.
ZEROCODE_ALLOW_ANONYMOUS=false

# Anonymous quota: max submissions per IP per window.
ZEROCODE_ANON_MAX_PER_WINDOW=6
ZEROCODE_ANON_WINDOW_SECS=60


# ─── Worker (zerocode-worker) ──────────────────────────────────────────

# Stable identifier persisted with claimed jobs. Auto-generates a
# `worker-<ulid>` if unset; set explicitly when running multiple workers
# so logs and the stuck-job sweeper can attribute rows correctly.
# ZEROCODE_WORKER_ID=worker-1

# Concurrent sandbox count. Defaults to num_cpus.
# ZEROCODE_MAX_PARALLEL=4

# Prometheus metrics endpoint for the worker (the API exposes its own on
# the main bind address at /metrics).
# ZEROCODE_WORKER_METRICS_BIND=0.0.0.0:9090


# ─── Sandbox runtime paths (worker, --features native) ─────────────────

# Where the worker mounts the extracted runner-image filesystem.
ZEROCODE_RUNNER_ROOTFS=/var/lib/zerocode/runner-rootfs

# Cgroup parent under which per-submission child cgroups are created.
# See docs/DEPLOY.md §6 for cgroup delegation.
# ZEROCODE_CGROUP_PARENT=/sys/fs/cgroup/zerocode

# Where per-submission scratch dirs are created.
# ZEROCODE_SCRATCH_DIR=/run/zerocode-sandbox


# ─── Retention (sweeper, runs inside each worker) ──────────────────────

# How long completed submissions stay in the table before deletion.
ZEROCODE_RETENTION_HOURS=24

# How long large stdout/stderr blobs stay before being scrubbed
# (submission row stays; just payload columns are cleared).
ZEROCODE_PAYLOAD_TTL_SECS=3600


# ─── Logging ───────────────────────────────────────────────────────────

# tracing/env_filter directive. `info` is sensible for prod; debug-level
# the ZeroCode crates only for dev.
RUST_LOG=info,zerocode=debug
