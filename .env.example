# Postgres connection (used by api, worker, migrate)
DATABASE_URL=postgres://zerocode:zerocode@localhost:5432/zerocode

# Static API key for v1 (Bearer auth)
ZEROCODE_API_KEY=dev-only-replace-me

# HMAC secret for outbound webhook signatures (X-ZeroCode-Signature)
ZEROCODE_WEBHOOK_SECRET=dev-only-replace-me

# Listen address for the API server
ZEROCODE_API_BIND=0.0.0.0:8080

# Path the worker mounts read-only as the sandbox rootfs (set in compose)
ZEROCODE_RUNNER_ROOTFS=/var/lib/zerocode/runner-rootfs

# Retention
ZEROCODE_RETENTION_HOURS=24
ZEROCODE_PAYLOAD_TTL_SECS=3600

# Logging
RUST_LOG=info,zerocode=debug

# sqlx offline mode: read cached query metadata from .sqlx/ instead of
# requiring a live Postgres at compile time. Refresh with:
#   cargo sqlx prepare --workspace
SQLX_OFFLINE=true

# OTLP tracing export. When set, both api and worker batch-export spans via
# gRPC to the configured collector. Unset/empty disables OTLP (stdout JSON
# only). Dev compose ships a Jaeger all-in-one on http://localhost:4317
# with a UI at http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
