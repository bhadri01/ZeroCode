# ZeroCode environment template — minimal working set.
#
# Copy to `.env` and adjust. The full list of tunable env vars (defaults,
# advanced knobs, sandbox paths, governor settings) lives in docs/DEPLOY.md §2.

# Postgres connection string. Used by API, worker, and the migrate binary.
DATABASE_URL=postgres://zerocode:zerocode@localhost:5432/zerocode

# tracing/env_filter directive.
RUST_LOG=info,zerocode=debug
