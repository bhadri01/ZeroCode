---
/*
 * Header override — the sole path back out of /docs/* to / and
 * /playground.html. Replaces the default SocialIcons slot so we still
 * render the GitHub icon afterwards via <Default>.
 *
 * Why this is in the header (not the sidebar)
 * ───────────────────────────────────────────
 * Starlight's sidebar normalizer rewrites path-style `link` values:
 * it strips file extensions and base-prefixes with the docs base. So
 * `link: '/playground.html'` became `href="/docs/playground"` (404).
 * Raw <a> tags inside an Astro component go through unchanged, so the
 * header is the safe place for these.
 *
 * `data-astro-reload` forces a full browser navigation when Starlight
 * later enables view transitions — without it the client-side router
 * could try to swap into Vite-served pages it doesn't own.
 *
 * Visible at all viewport sizes (no media-query gate). Two short text
 * labels fit fine in Starlight's mobile header strip.
 */
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="zc-header-out">
  <a href="/" class="zc-link" data-astro-reload>home</a>
  <a href="/playground.html" class="zc-link" data-astro-reload>playground</a>
</div>
<Default><slot /></Default>

<style>
  .zc-header-out {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-right: 4px;
    padding-right: 12px;
    border-right: 1px solid var(--sl-color-gray-5);
  }
  .zc-link {
    font: 500 12.5px var(--sl-font-system-mono, ui-monospace, monospace);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .zc-link:hover,
  .zc-link:focus-visible {
    color: var(--sl-color-white);
  }
  /* Tighten spacing on small screens so the GitHub icon + theme toggle
     still have room next to the back-out links. */
  @media (max-width: 30em) {
    .zc-header-out { gap: 10px; padding-right: 8px; }
    .zc-link { font-size: 11.5px; }
  }
</style>
