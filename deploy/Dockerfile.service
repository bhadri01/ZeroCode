# syntax=docker/dockerfile:1.7
#
# Distroless image for the API + migrate binaries. The worker uses a glibc
# image (Dockerfile.worker) because libcontainer needs glibc; this image is
# fully static (musl) so the attack surface is minimal.
#
# Build with:
#   docker build -f deploy/Dockerfile.service -t zerocode-service:dev .

FROM node:20-bookworm-slim AS web
WORKDIR /web
ENV CI=true
# Hide the docs surface for the test launch (links dropped, /docs/ 404s).
# Re-enable docs with:  docker build --build-arg VITE_HIDE_DOCS=false ...
ARG VITE_HIDE_DOCS=true
ENV VITE_HIDE_DOCS=${VITE_HIDE_DOCS}
RUN corepack enable
COPY web ./
RUN rm -rf node_modules app/node_modules docs/node_modules dist app/dist docs/dist .astro docs/.astro
RUN pnpm install --frozen-lockfile || pnpm install
RUN pnpm build

FROM rust:1-bookworm AS builder
WORKDIR /src
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        musl-tools pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY Cargo.toml rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY .sqlx ./.sqlx

# Build only the API + migrate binaries — sandbox/worker stay out of this image.
ENV SQLX_OFFLINE=true
RUN case "$TARGETARCH" in \
        amd64) rust_target="x86_64-unknown-linux-musl" ;; \
        arm64) rust_target="aarch64-unknown-linux-musl" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && rustup target add "$rust_target" \
    && cargo build \
        --release \
        --target "$rust_target" \
        -p zerocode-api \
        -p zerocode-migrate \
    && mkdir -p /out \
    && cp "target/${rust_target}/release/zerocode-api" /out/zerocode-api \
    && cp "target/${rust_target}/release/zerocode-migrate" /out/zerocode-migrate

FROM gcr.io/distroless/static-debian12:nonroot AS service
COPY --from=builder /out/zerocode-api /usr/local/bin/zerocode-api
COPY --from=builder /out/zerocode-migrate /usr/local/bin/zerocode-migrate
COPY --from=builder /src/migrations /var/lib/zerocode/migrations
COPY runners/languages.toml /runners/languages.toml
COPY --from=web /web/dist /srv/web
ENV ZEROCODE_LANGUAGES_FILE=/runners/languages.toml \
    ZEROCODE_WEB_DIR=/srv/web
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/zerocode-api"]
