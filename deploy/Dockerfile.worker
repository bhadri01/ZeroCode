# syntax=docker/dockerfile:1.7
#
# The worker needs glibc + libseccomp. Built against debian-trixie-slim to
# match the runner image's libc. Kept distinct from the API image so the
# blast radius of a worker bug stays small.

FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libseccomp-dev clang && \
    rm -rf /var/lib/apt/lists/*

COPY Cargo.toml rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY .sqlx ./.sqlx

# Build the worker with the `native` sandbox feature enabled so submissions
# run inside a real OS-level sandbox: cgroup v2 limits + PID/NET/IPC/UTS/MNT/
# USER namespaces + dropped capabilities + seccomp + landlock, pivot_root'd
# into the read-only runner rootfs.
ENV SQLX_OFFLINE=true
# NOTE: the `unsafe-naive` feature builds the dev-only NaiveSandbox, which runs
# user code as host root with NO isolation ("never enable in production"). It
# was used here previously only because Docker Desktop's Linux VM on macOS
# doesn't delegate cgroup controllers out of the box. On a real Linux host the
# worker-entrypoint.sh below sets up the delegated cgroup subtree, so prefer
# `native`. Swap back to `unsafe-naive` only for macOS Docker Desktop dev.
RUN cargo build --release -p zerocode-worker --features native

FROM debian:trixie-slim AS worker
# `mount`/util-linux + libseccomp2 are needed so the NativeSandbox can mount
# /proc, pivot_root into the runner rootfs, and install its seccomp filter.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libseccomp2 iproute2 mount util-linux && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/zerocode-worker /usr/local/bin/zerocode-worker
COPY runners/languages.toml /runners/languages.toml
COPY deploy/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh
ENV ZEROCODE_LANGUAGES_FILE=/runners/languages.toml
# Run as root inside the container so the NativeSandbox can write to
# /sys/fs/cgroup, unshare user namespaces, and pivot_root. The container
# itself drops every capability except SYS_ADMIN (see compose), and the
# sandbox per-submission drops everything before exec'ing user code.
# The entrypoint provisions the delegated cgroup subtree + scratch dir, then
# exec's the worker binary as PID 1.
ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
