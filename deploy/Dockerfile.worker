# syntax=docker/dockerfile:1.7
#
# The worker needs glibc + libseccomp. Built against debian-trixie-slim to
# match the runner image's libc. Kept distinct from the API image so the
# blast radius of a worker bug stays small.

FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libseccomp-dev clang && \
    rm -rf /var/lib/apt/lists/*

COPY Cargo.toml rust-toolchain.toml ./
COPY crates ./crates
COPY migrations ./migrations
COPY .sqlx ./.sqlx

# Build the worker with the `native` sandbox feature enabled so the
# worker can actually run submissions inside an OS-level sandbox.
ENV SQLX_OFFLINE=true
# Use an unsafe, naive sandbox for local development where kernel cgroup
# features are unavailable (Docker for Mac). Do NOT use in production.
RUN cargo build --release -p zerocode-worker --features unsafe-naive

FROM debian:trixie-slim AS worker
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libseccomp2 iproute2 && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd --system zerocode && useradd --system --gid zerocode --uid 10001 --home /var/lib/zerocode --no-create-home zerocode
COPY --from=builder /src/target/release/zerocode-worker /usr/local/bin/zerocode-worker
COPY runners/languages.toml /runners/languages.toml
ENV ZEROCODE_LANGUAGES_FILE=/runners/languages.toml
USER zerocode
ENTRYPOINT ["/usr/local/bin/zerocode-worker"]
